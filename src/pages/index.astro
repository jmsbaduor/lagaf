---
import Layout from "@/layouts/main.astro"
import MarkLoader from "@/components/MarkLoader.astro"
import { ChartStage } from "@/canvas/chart-stage"
import { charts } from "@/canvas/registry"

const first = charts[0]
---

<Layout title="lagaf" image="/og/home.png">
  <ChartStage client:only="react" initial={first.slug}>
    <MarkLoader slot="fallback" />
  </ChartStage>
</Layout>
